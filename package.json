{
  "name": "pitch-fork-mcp-server",
  "version": "1.0.0",
  "description": "Pitch-Fork is a remote MCP server for company discovery and market intelligence, providing company names, industries, valuations, and locations to ChatGPT, Claude Desktop, and other MCP-compatible clients.",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supportbridge/sdk": "0.10.2",
    "express": "^4.21.2",
    "jose": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
